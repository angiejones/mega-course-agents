# Set your API key in .env.local. Keep credentials out of this template.
OPENAI_API_KEY=
MODEL_SMALL=openai/gpt-6-luna
MODEL_CAPABLE=openai/gpt-6-sol
STORE_DB_PATH=data/store.db
AGENT_DB_PATH=data/agent.db
CUSTOMER_ID=customer-alex
CATALOG_MCP_URL=http://localhost:4112/mcp
ORDERS_MCP_URL=http://localhost:4113/mcp
DELIVERY_AGENT_URL=http://localhost:4114
SUPPLIER_AGENT_URL=http://localhost:4115

# Hosted Jev API. Add your own key privately to .env.local.
TYPESAFE_API_KEY=
# Pinned decision model; verify account access before use.
TYPESAFE_MODEL=jev-1.13.0

# Independent collaboration services and personal shopping Studio.
CARRIER_URL=http://127.0.0.1:4301
SUPPLIER_URL=http://127.0.0.1:4302
RETAIL_GATEWAY_URL=http://127.0.0.1:4303
CARRIER_TOKEN=
SUPPLIER_TOKEN=
SHOPPING_TOKEN=
SHOPPING_AGENT_DB_PATH=data/shopping-agent.db
SHOPPING_DELEGATION_DB_PATH=data/shopping-delegations.db
