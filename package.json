{
  "name": "mega-course-agents",
  "version": "1.0.0",
  "description": "MEGA retail agent course",
  "scripts": {
    "dev": "mastra dev --dir apps/retail/src/mastra",
    "start": "npm run dev",
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/seed.ts",
    "health": "tsx scripts/health.ts",
    "chat": "tsx scripts/chat.ts",
    "test": "tsx --test packages/*/*.test.ts",
    "typecheck": "tsc --noEmit",
    "eval": "tsx scripts/eval.ts",
    "verify:models": "tsx scripts/verify-models.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run typecheck && npm test && npm run check:secrets",
    "build": "mastra build --dir apps/retail/src/mastra",
    "reset:preferences": "tsx scripts/reset-preferences.ts",
    "rehearse:chapter1": "tsx scripts/chapter1-evidence.ts",
    "verify:step-limit": "tsx scripts/check-step-limit.ts",
    "prepare:exchanges": "tsx scripts/prepare-exchange-store.ts",
    "verify:jev": "tsx scripts/verify-jev.ts",
    "exchange": "tsx scripts/exchange.ts",
    "verify:exchange-services": "tsx scripts/verify-exchange-services.ts",
    "verify:exchange-agent": "tsx scripts/check-exchange-agent.ts",
    "verify:exchange-workflow": "tsx scripts/verify-exchange-workflow.ts",
    "verify:exchange-chat": "tsx scripts/verify-exchange-chat.ts",
    "dev:exchanges": "tsx scripts/prepare-exchange-store.ts --studio",
    "example:structured-response": "tsx scripts/structured-response.ts",
    "verify:exchange-structured": "tsx scripts/verify-exchange-chat.ts --structured",
    "verify:mcp-input": "tsx scripts/verify-mcp-exchange.ts",
    "verify:code-mode": "tsx scripts/verify-code-mode.ts",
    "compare:code-mode": "tsx scripts/compare-code-mode.ts",
    "verify:capabilities": "tsx scripts/verify-agent-capabilities.ts",
    "verify:product-care": "tsx scripts/verify-product-care.ts",
    "verify:mcp-exchange": "tsx scripts/verify-mcp-exchange.ts",
    "build:mcp-app": "tsx scripts/build-exchange-app.ts",
    "dev:mcp-app": "npm run build:mcp-app && RETAIL_MCP_APPS=true npm run dev:exchanges",
    "verify:mcp-app": "npm run build:mcp-app && tsx scripts/verify-mcp-app.ts",
    "verify:skill-discovery": "tsx scripts/verify-skill-discovery.ts",
    "verify:missing-item": "tsx scripts/verify-missing-item.ts",
    "prepare:collaboration": "tsx scripts/prepare-collaboration.ts",
    "serve:carrier": "tsx scripts/serve-specialist.ts carrier",
    "serve:supplier": "tsx scripts/serve-specialist.ts supplier",
    "serve:retail-gateway": "tsx scripts/serve-retail-gateway.ts",
    "shopping": "tsx agents/shopping-client/client.ts",
    "verify:collaboration": "tsx --test packages/collaboration/*.test.ts",
    "verify:collaboration-live": "tsx scripts/verify-collaboration-live.ts",
    "compare:products": "tsx scripts/compare-products.ts",
    "compare:assessment-architectures": "tsx scripts/compare-assessment-architectures.ts",
    "dev:shopping": "cd apps/shopping && mastra dev --dir src/mastra",
    "verify:delegation-live": "tsx scripts/verify-agent-delegation-live.ts",
    "verify:delivery-reasoning": "tsx scripts/verify-delivery-reasoning.ts",
    "recording:request": "tsx scripts/recording-request.ts",
    "verify:collaboration-progression": "tsx scripts/verify-collaboration-progression.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angiejones/mega-course-agents.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/angiejones/mega-course-agents/issues"
  },
  "homepage": "https://github.com/angiejones/mega-course-agents#readme",
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@mastra/core": "1.77.0",
    "@mastra/libsql": "1.26.1",
    "@mastra/mcp": "2.4.1",
    "@mastra/memory": "1.37.1",
    "@mastra/observability": "1.20.0",
    "@mastra/quickjs": "0.1.3",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@typesafe-ai/sdk": "0.7.0",
    "dotenv": "18.0.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "mastra": "1.34.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "packageManager": "npm@10.9.9"
}
